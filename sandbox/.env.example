PORT=4010

# HS256 secret used to sign/verify dev Bearer JWTs issued by POST /oauth/token
SANDBOX_JWT_SECRET=dev-insecure-secret-change-me

# When true, express-openapi-validator also validates outgoing responses against TOMP-API.yaml.
# Off by default: the spec's `error.status`/`error.errorcode` fields are typed as tinyInt (0-10),
# which real HTTP status codes like 404/409 exceed - a known upstream spec quirk. Turn this on to
# contract-test the success-path responses; expect the 4xx/5xx error responses to fail validation.
VALIDATE_RESPONSES=false

# When true, POST /oauth/token requires client_id/client_secret to match the values below.
# Off by default: any non-empty client_id/client_secret pair is accepted (sandbox mode).
SANDBOX_STRICT_AUTH=false
SANDBOX_CLIENT_ID=
SANDBOX_CLIENT_SECRET=

# State is mirrored to a JSON dump on every mutation and reloaded on startup, so data survives
# restarts. Set to false to run purely in-memory (e.g. for a clean-slate demo, or tests).
SANDBOX_PERSIST=true
# Path is relative to the sandbox/ folder.
SANDBOX_DATA_FILE=.data/store.json

# Which shared-mobility operator this instance simulates (src/data/providers.js). Each one offers
# a single mode with example vehicles in Amsterdam and/or Utrecht, like a real operator would:
#   gosharing (default) - shared bicycle, Amsterdam + Utrecht
#   felyx               - shared moped, Amsterdam + Utrecht
#   check               - shared bicycle, Amsterdam
#   uber                - taxi, Amsterdam + Utrecht
#   bolt                - taxi, Amsterdam
#   viavan              - taxi, Utrecht
# Start several sandboxes with a different PORT + SANDBOX_PROVIDER to simulate several operators
# at once - see "Simulating different providers" in README.md.
SANDBOX_PROVIDER=gosharing
